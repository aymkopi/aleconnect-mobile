{
  "name": "aleconnect-mobile",
  "main": "./index.ts",
  "version": "2.0.0",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "android:preview": "node -e \"if (Number(process.versions.node.split('.')[0]) !== 24 || Number(process.versions.node.split('.')[1]) < 3) throw new Error('ALEConnect Android previews require Node 24 LTS (24.3+)'); if (!(process.env.EXPO_PUBLIC_ALECONNECT_API_URL || process.env.EXPO_PUBLIC_API_URL)) throw new Error('Set the configured public API URL'); if (process.env.EXPO_PUBLIC_PANELUI_PREVIEW !== '1') throw new Error('Set EXPO_PUBLIC_PANELUI_PREVIEW=1 to pause queue replay')\" && expo prebuild --no-clean --platform android --no-install && cd android && set NODE_ENV=production&& gradlew.bat :app:assemblePreview --no-daemon",
    "android:sync": "expo prebuild --clean --platform android --no-install",
    "ios": "expo run:ios",
    "web": "npm run sync:web-map && expo start --web",
    "harness:check": "node scripts/validate-agent-harness.mjs",
    "harness:doctor": "node scripts/check-agent-worktree.mjs",
    "lint": "expo lint",
    "sync:web-map": "node scripts/sync-web-map-worker.mjs",
    "postinstall": "npm run sync:web-map",
    "export:web": "npm run sync:web-map && expo export --platform web"
  },
  "dependencies": {
    "@expo/html-elements": "~57.0.0",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-background-task": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "lucide-react-native": "^1.51.0",
    "maplibre-gl": "^6.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.4",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-keyboard-controller"
      ]
    }
  }
}
