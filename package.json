{
  "name": "aleconnect-mobile",
  "main": "./index.ts",
  "version": "1.0.0",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "android": "expo run:android",
    "android:preview": "node -e \"if (process.versions.node.split('.')[0] !== '22') throw new Error('ALEConnect Android previews require Node 22 LTS')\" && expo prebuild --no-clean --platform android --no-install && cd android && set NODE_ENV=production&& gradlew.bat :app:assemblePreview --no-daemon",
    "android:sync": "expo prebuild --clean --platform android --no-install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "harness:check": "node scripts/validate-agent-harness.mjs",
    "harness:doctor": "node scripts/check-agent-worktree.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/html-elements": "~57.0.0",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@maplibre/maplibre-react-native": "^11.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/feather": "^13.1.4",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "expo": "~57.0.26",
    "expo-background-task": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "lucide-react-native": "^1.51.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.2.2",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "private": true
}
