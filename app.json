{
  "expo": {
    "name": "Aleconnect",
    "slug": "aleconnect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aleconnectmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kapecakes.aleconnectmobile",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ALEConnect uses your location to place complaint map pins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/aleconnect-icon-foreground.png",
        "backgroundImage": "./assets/images/aleconnect-icon-background.png",
        "monochromeImage": "./assets/images/aleconnect-icon-monochrome.png"
      },
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.kapecakes.aleconnectmobile",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f8fafc",
      "translucent": false,
      "hidden": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F3FF",
          "android": {
            "image": "./assets/images/aleconnect-icon-foreground.png",
            "imageWidth": 100
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/high_critical_alert.wav",
            "./assets/sounds/info_alert.wav",
            "./assets/sounds/low_medium_alert.wav"
          ],
          "icon": "./assets/images/aleconnect-icon-white.png",
          "color": "#F2F8FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ALEConnect uses selected photos as complaint evidence and profile images.",
          "cameraPermission": "ALEConnect uses your camera to take photos for report evidence.",
          "microphonePermission": false
        }
      ],
      "expo-location",
      "expo-web-browser",
      "./plugins/with-android-predictive-back-disabled",
      "./plugins/with-report-evidence-backup-exclusion",
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f488511c-eb50-425b-ba23-0281a1c572e7"
      }
    }
  }
}
